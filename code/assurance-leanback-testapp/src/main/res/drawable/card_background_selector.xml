<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_selected" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focused" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_selected" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <stroke android:width="1dp" android:color="@color/background_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector> 